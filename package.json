{
  "name": "morphloom",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Open-source, model-agnostic 3D asset foundry for editable humans, products, and assemblies.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "morphloom": "vite-node scripts/morphloom.ts",
    "benchmark": "vite-node scripts/benchmark.ts",
    "benchmark:competitive": "vite-node scripts/competitive-benchmark.ts",
    "benchmark:fixtures": "vite-node scripts/export-cross-domain-fixtures.ts",
    "benchmark:blender-cross-domain": "vite-node scripts/blender-cross-domain-benchmark.ts",
    "benchmark:blender-cross-domain-edit": "vite-node scripts/blender-cross-domain-edit-benchmark.ts tmp/native-fixtures benchmarks/blender-cross-domain-edit-latest.json",
    "benchmark:blender-component-edit": "blender --background --python-exit-code 1 --python scripts/blender-component-edit-audit.py -- tmp/abo-semantic-fan/abo-industrial-floor-fan-semantic.glb tmp/abo-semantic-fan/abo-industrial-floor-fan-edited.glb benchmarks/blender-component-edit-latest.json speed-knob 12 0 0 && npm run gltf:validate -- tmp/abo-semantic-fan/abo-industrial-floor-fan-edited.glb && npm run gltf:validate -- tmp/abo-semantic-fan/abo-industrial-floor-fan-edited-stability.glb",
    "benchmark:neutral-render": "blender --background --python-exit-code 1 --python scripts/blender-neutral-render.py --",
    "benchmark:neutral-audit": "vite-node scripts/audit-neutral-render-set.ts",
    "benchmark:static-delivery": "vite-node scripts/static-delivery-benchmark.ts",
    "benchmark:unity-cross-domain": "vite-node scripts/unity-cross-domain-benchmark.ts",
    "benchmark:godot-cross-domain": "vite-node scripts/godot-cross-domain-benchmark.ts",
    "benchmark:prusaslicer": "vite-node scripts/prusaslicer-print-benchmark.ts",
    "benchmark:visual-captures": "vite-node scripts/audit-visual-captures.ts",
    "benchmark:visual-set": "vite-node scripts/audit-visual-capture-set.ts",
    "benchmark:dominance": "vite-node scripts/production-dominance-benchmark.ts",
    "benchmark:holdout:lock": "vite-node scripts/lock-abo-holdout.ts",
    "benchmark:holdout:nightstand": "vite-node scripts/abo-nightstand-holdout-candidate.ts",
    "benchmark:holdout:nightstand:compare": "vite-node scripts/compare-sealed-nightstand-holdout.ts",
    "benchmark:ground-truth": "vite-node scripts/ground-truth-corpus-benchmark.ts",
    "benchmark:abo-scale": "vite-node scripts/abo-multiview-scale-pilot.ts",
    "benchmark:abo-hull": "vite-node scripts/abo-visual-hull-pilot.ts",
    "benchmark:abo-semantic-lamp": "vite-node scripts/abo-semantic-lamp-pilot.ts",
    "benchmark:abo-semantic-fan": "vite-node scripts/abo-semantic-fan-pilot.ts",
    "benchmark:abo-semantic-fan:geometry": "vite-node scripts/abo-semantic-fan-pilot.ts --geometry-only",
    "benchmark:img2threejs-fan-candidate": "vite-node scripts/export-img2threejs-candidate.ts work/img2threejs-fan-run/comparison-run/fan/src/createFanModel.ts tmp/img2threejs-fan-candidate/img2threejs-fan.glb createIndustrialFloorFanModel --allow-trusted-local-candidate",
    "surface:prepare": "vite-node scripts/prepare-surface-reference.ts",
    "benchmark:asphalt-same-input": "vite-node scripts/asphalt-same-input-benchmark.ts",
    "gltf:validate": "vite-node scripts/validate-glb.ts",
    "gltf:repair": "vite-node scripts/repair-glb-interchange.ts",
    "gltf:compare-surface": "vite-node scripts/compare-glb-surface.ts",
    "blender:validate": "blender --background --python-exit-code 1 --python scripts/blender-glb-roundtrip.py --",
    "blender:static-audit": "blender --background --python-exit-code 1 --python scripts/blender-static-mesh-audit.py --",
    "quality:gate": "vite-node scripts/quality-gate.ts && vite-node scripts/competitive-benchmark.ts",
    "quality:production": "npm run quality:gate && npm run benchmark:dominance -- --require-claim",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "meshoptimizer": "~0.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@napi-rs/canvas": "^1.0.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "gltf-validator": "^2.0.0-dev.3.10",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
