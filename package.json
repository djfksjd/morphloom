{
  "name": "morphloom",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Open-source, model-agnostic 3D asset foundry for editable humans, products, and assemblies.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "vite-node scripts/benchmark.ts",
    "benchmark:competitive": "vite-node scripts/competitive-benchmark.ts",
    "benchmark:fixtures": "vite-node scripts/export-cross-domain-fixtures.ts",
    "benchmark:blender-cross-domain": "vite-node scripts/blender-cross-domain-benchmark.ts",
    "benchmark:visual-captures": "vite-node scripts/audit-visual-captures.ts",
    "benchmark:visual-set": "vite-node scripts/audit-visual-capture-set.ts",
    "surface:prepare": "vite-node scripts/prepare-surface-reference.ts",
    "gltf:validate": "vite-node scripts/validate-glb.ts",
    "gltf:repair": "vite-node scripts/repair-glb-interchange.ts",
    "blender:validate": "blender --background --python-exit-code 1 --python scripts/blender-glb-roundtrip.py --",
    "quality:gate": "vite-node scripts/quality-gate.ts && vite-node scripts/competitive-benchmark.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@napi-rs/canvas": "^1.0.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "gltf-validator": "^2.0.0-dev.3.10",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
