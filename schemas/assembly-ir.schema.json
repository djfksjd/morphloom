{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djfksjd/morphloom/schemas/assembly-ir.schema.json",
  "title": "Morphloom AssemblyIR 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "units", "components"],
  "properties": {
    "schema": { "const": "morphloom.assembly/0.1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "units": { "const": "mm" },
    "metadata": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "electrical": { "$ref": "#/$defs/electricalHarness" },
    "fidelity": { "$ref": "fidelity-contract.schema.json" },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "minItems": 3,
      "maxItems": 3
    },
    "vec2": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color"],
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "surface": { "enum": ["raw", "concrete", "plaster", "stone", "coated-metal", "brushed-metal", "bead-blasted-metal", "anodized-metal", "polished-metal", "machined-copper", "ceramic-glass", "optical-glass", "sapphire", "pcb-soldermask", "molded-polymer", "soft-touch-polymer", "rubber", "leather", "wood", "skin", "fabric", "hex-knit", "hair", "semiconductor"] },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "metalness": { "type": "number", "minimum": 0, "maximum": 1 },
        "transmission": { "type": "number", "minimum": 0, "maximum": 1 },
        "clearcoat": { "type": "number", "minimum": 0, "maximum": 1 },
        "clearcoatRoughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "ior": { "type": "number", "minimum": 1, "maximum": 2.5 },
        "iridescence": { "type": "number", "minimum": 0, "maximum": 1 },
        "anisotropy": { "type": "number", "minimum": 0, "maximum": 1 },
        "anisotropyRotation": { "type": "number", "minimum": -6.2832, "maximum": 6.2832 },
        "sheen": { "type": "number", "minimum": 0, "maximum": 1 },
        "sheenRoughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "specularIntensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "microNormalStrength": { "type": "number", "minimum": 0, "maximum": 1 },
        "textureScale": {
          "type": "array",
          "prefixItems": [{ "type": "number", "exclusiveMinimum": 0, "maximum": 1024 }, { "type": "number", "exclusiveMinimum": 0, "maximum": 1024 }],
          "minItems": 2,
          "maxItems": 2
        },
        "thicknessMm": { "type": "number", "minimum": 0, "maximum": 100 },
        "emissive": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "referenceProjection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "mapping", "crop", "boundsMm"],
          "properties": {
            "uri": { "type": "string", "minLength": 1, "maxLength": 512 },
            "mapping": { "const": "assembly-xy" },
            "crop": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 4, "maxItems": 4 },
            "boundsMm": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 4, "maxItems": 4 },
            "fingerprint": { "type": "string", "pattern": "^[a-fA-F0-9]{8,128}$" },
            "relief": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "strength": { "type": "number", "minimum": 0, "maximum": 2 },
                "maxResolution": { "type": "integer", "minimum": 256, "maximum": 2048 }
              }
            }
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "materialName", "detail", "geometry", "material"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "enum": ["enclosure", "display", "logic", "power", "camera", "audio", "radio", "mechanical", "interconnect"] },
        "materialName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "detail": { "type": "string", "maxLength": 500 },
        "level": { "type": "string", "minLength": 1, "maxLength": 40 },
        "position": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/vec3" },
        "scale": { "$ref": "#/$defs/vec3" },
        "evidence": { "$ref": "#/$defs/componentEvidence" },
        "material": { "$ref": "#/$defs/material" },
        "light": { "$ref": "#/$defs/light" },
        "geometry": {
          "oneOf": [
            { "$ref": "#/$defs/roundedBox" },
            { "$ref": "#/$defs/cylinder" },
            { "$ref": "#/$defs/sphere" },
            { "$ref": "#/$defs/torus" },
            { "$ref": "#/$defs/extrude" },
            { "$ref": "#/$defs/lathe" },
            { "$ref": "#/$defs/tube" },
            { "$ref": "#/$defs/hipRoof" },
            { "$ref": "#/$defs/bladeLoft" },
            { "$ref": "#/$defs/visualHull" }
          ]
        }
      }
    },
    "componentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["measured", "datasheet", "estimated", "inferred"] },
        "source": { "type": "string", "maxLength": 500 },
        "notes": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 500 } }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "intensity", "rangeMm"],
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1000 },
        "rangeMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
        "decay": { "type": "number", "minimum": 0, "maximum": 4 }
      }
    },
    "roundedBox": {
      "type": "object", "required": ["op", "size", "radius"], "additionalProperties": false,
      "properties": { "op": { "const": "roundedBox" }, "size": { "$ref": "#/$defs/vec3" }, "radius": { "type": "number", "minimum": 0 }, "segments": { "type": "integer", "minimum": 3, "maximum": 512 } }
    },
    "cylinder": {
      "type": "object", "required": ["op", "radiusTop", "radiusBottom", "depth"], "additionalProperties": false,
      "properties": { "op": { "const": "cylinder" }, "radiusTop": { "type": "number", "minimum": 0 }, "radiusBottom": { "type": "number", "minimum": 0 }, "depth": { "type": "number", "exclusiveMinimum": 0 }, "radialSegments": { "type": "integer", "minimum": 3, "maximum": 512 } }
    },
    "sphere": {
      "type": "object", "required": ["op", "radius"], "additionalProperties": false,
      "properties": { "op": { "const": "sphere" }, "radius": { "type": "number", "exclusiveMinimum": 0 }, "widthSegments": { "type": "integer", "minimum": 3, "maximum": 512 }, "heightSegments": { "type": "integer", "minimum": 3, "maximum": 512 } }
    },
    "torus": {
      "type": "object", "required": ["op", "radius", "tube"], "additionalProperties": false,
      "properties": { "op": { "const": "torus" }, "radius": { "type": "number", "exclusiveMinimum": 0 }, "tube": { "type": "number", "exclusiveMinimum": 0 }, "radialSegments": { "type": "integer", "minimum": 3, "maximum": 512 }, "tubularSegments": { "type": "integer", "minimum": 3, "maximum": 512 } }
    },
    "extrude": {
      "type": "object", "required": ["op", "points", "depth"], "additionalProperties": false,
      "properties": {
        "op": { "const": "extrude" },
        "points": { "type": "array", "minItems": 3, "maxItems": 4096, "items": { "$ref": "#/$defs/vec2" } },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "holes": { "type": "array", "maxItems": 128, "items": { "type": "array", "minItems": 3, "maxItems": 4096, "items": { "$ref": "#/$defs/vec2" } } },
        "ovalHoles": {
          "type": "array", "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["center", "radii"],
            "properties": {
              "center": { "$ref": "#/$defs/vec2" }, "radii": { "$ref": "#/$defs/vec2" },
              "segments": { "type": "integer", "minimum": 8, "maximum": 256 }
            }
          }
        },
        "bevelSize": { "type": "number", "minimum": 0 },
        "bevelThickness": { "type": "number", "minimum": 0 },
        "bevelSegments": { "type": "integer", "minimum": 1, "maximum": 512 },
        "edgeTapers": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "width", "tipThickness"],
            "properties": {
              "path": { "type": "array", "minItems": 2, "maxItems": 512, "items": { "$ref": "#/$defs/vec2" } },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "tipThickness": { "type": "number", "exclusiveMinimum": 0 },
              "curve": { "type": "number", "minimum": 0.25, "maximum": 4 }
            }
          }
        }
      }
    },
    "lathe": {
      "type": "object", "required": ["op", "profile"], "additionalProperties": false,
      "properties": { "op": { "const": "lathe" }, "profile": { "type": "array", "minItems": 3, "maxItems": 4096, "items": { "$ref": "#/$defs/vec2" } }, "segments": { "type": "integer", "minimum": 3, "maximum": 512 } }
    },
    "tube": {
      "type": "object", "required": ["op", "points", "radius"], "additionalProperties": false,
      "properties": { "op": { "const": "tube" }, "points": { "type": "array", "minItems": 2, "maxItems": 4096, "items": { "$ref": "#/$defs/vec3" } }, "radius": { "type": "number", "exclusiveMinimum": 0 }, "tubularSegments": { "type": "integer", "minimum": 3, "maximum": 512 }, "radialSegments": { "type": "integer", "minimum": 3, "maximum": 512 }, "closed": { "type": "boolean" } }
    },
    "hipRoof": {
      "type": "object", "required": ["op", "width", "depth", "rise", "thickness", "ridgeLength"], "additionalProperties": false,
      "properties": {
        "op": { "const": "hipRoof" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "rise": { "type": "number", "exclusiveMinimum": 0 },
        "thickness": { "type": "number", "exclusiveMinimum": 0 },
        "ridgeLength": { "type": "number", "minimum": 0 }
      }
    },
    "bladeLoft": {
      "type": "object", "required": ["op", "sections", "thickness", "apexThickness"], "additionalProperties": false,
      "properties": { "op": { "const": "bladeLoft" }, "sections": { "type": "array", "minItems": 3, "maxItems": 512, "items": { "$ref": "#/$defs/vec2" } }, "thickness": { "type": "number", "exclusiveMinimum": 0 }, "apexThickness": { "type": "number", "exclusiveMinimum": 0 }, "grindCurve": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "number", "minimum": 0, "maximum": 1 } } }
    },
    "visualHull": {
      "type": "object",
      "required": ["op", "descriptor"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "visualHull" },
        "descriptor": {
          "type": "object",
          "required": ["projection", "boundsSpace", "bounds", "resolution", "triangleBudget", "views"],
          "additionalProperties": false,
          "properties": {
            "projection": { "const": "orthographic" },
            "boundsSpace": { "const": "component-local" },
            "bounds": {
              "type": "object",
              "required": ["min", "max"],
              "additionalProperties": false,
              "properties": { "min": { "$ref": "#/$defs/vec3" }, "max": { "$ref": "#/$defs/vec3" } }
            },
            "resolution": { "type": "integer", "minimum": 4, "maximum": 32 },
            "triangleBudget": { "type": "integer", "minimum": 1, "maximum": 400000 },
            "views": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": ["axis", "confidence", "mask"],
                "additionalProperties": false,
                "properties": {
                  "axis": { "enum": ["front", "side", "top"] },
                  "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                  "mask": { "type": "array", "minItems": 4, "maxItems": 256, "items": { "type": "string", "minLength": 4, "maxLength": 256, "pattern": "^[01]+$" } }
                }
              }
            },
            "hiddenRegions": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
          }
        }
      }
    },
    "electricalHarness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ports", "wires"],
      "properties": {
        "endpointToleranceMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "portToleranceMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "verificationScope": { "type": "string", "maxLength": 500 },
        "passiveNodes": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/passiveNode" } },
        "benchChecks": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/benchCheck" } },
        "ports": {
          "type": "array",
          "maxItems": 2000,
          "items": { "$ref": "#/$defs/electricalPort" }
        },
        "wires": {
          "type": "array",
          "maxItems": 2000,
          "items": { "$ref": "#/$defs/electricalWire" }
        }
      }
    },
    "electricalPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "componentId", "pin", "signal", "position"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
        "componentId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
        "pin": { "type": "string", "minLength": 1, "maxLength": 80 },
        "physicalPin": { "type": "string", "minLength": 1, "maxLength": 120 },
        "signal": { "$ref": "#/$defs/electricalSignal" },
        "position": { "$ref": "#/$defs/vec3" },
        "direction": { "$ref": "#/$defs/vec3" },
        "required": { "type": "boolean" },
        "maxConnections": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "electricalWire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "net", "signal", "from", "to", "diameter", "color"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "net": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
        "signal": { "$ref": "#/$defs/electricalSignal" },
        "from": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
        "to": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
        "waypoints": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/vec3" } },
        "diameter": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "materialName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "shielded": { "type": "boolean" },
        "gauge": { "type": "string", "pattern": "^(?:[0-9]{1,2}(?:\\.[0-9]+)?[Aa][Ww][Gg]|[0-9]+(?:\\.[0-9]+)?mm2)$" },
        "verification": { "$ref": "#/$defs/verification" }
      }
    },
    "passiveNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "node", "detail", "verification"],
      "properties": {
        "ref": { "type": "string", "minLength": 1, "maxLength": 120 },
        "node": { "type": "string", "minLength": 1, "maxLength": 500 },
        "detail": { "type": "string", "maxLength": 500 },
        "verification": { "$ref": "#/$defs/verification" }
      }
    },
    "benchCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "instruction", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 500 },
        "status": { "enum": ["required", "passed", "failed"] }
      }
    },
    "verification": {
      "enum": ["datasheet", "design", "bench-required", "bench-verified", "inferred"]
    },
    "electricalSignal": {
      "enum": ["power", "ground", "data", "rf", "audio", "sensor", "control"]
    }
  }
}
