{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ElementProject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "seed",
    "units",
    "coordinates",
    "parts",
    "regions",
    "groups",
    "elements"
  ],
  "properties": {
    "schema": {
      "const": "morphloom.elements/0.1"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "units": {
      "const": "mm"
    },
    "coordinates": {
      "const": "right-handed-y-up"
    },
    "parts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "regions": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "groups": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "elements": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "selection": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/elementId"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "maxLength": 512
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z0-9_-]+$"
    },
    "elementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 135,
      "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z0-9_-]+(?:/[0-9]{6})?$"
    },
    "slotId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(?!(?:__proto__|prototype|constructor)/)[A-Za-z0-9_-]+/[0-9]{6}$"
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -100000,
        "maximum": 100000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "scale": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0.01,
        "maximum": 100000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "rotation": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -6.283185307179586,
        "maximum": 6.283185307179586
      },
      "minItems": 3,
      "maxItems": 3
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source"
      ],
      "properties": {
        "status": {
          "enum": [
            "authored",
            "inferred",
            "observed"
          ]
        },
        "source": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "width",
        "thickness",
        "curvature",
        "twist",
        "color",
        "roughness"
      ],
      "properties": {
        "length": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100000
        },
        "width": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100000
        },
        "thickness": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100000
        },
        "curvature": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "twist": {
          "type": "number",
          "minimum": -6.283185307179586,
          "maximum": 6.283185307179586
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "partialParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "length": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100000
        },
        "width": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100000
        },
        "thickness": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100000
        },
        "curvature": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "twist": {
          "type": "number",
          "minimum": -6.283185307179586,
          "maximum": 6.283185307179586
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "params": {
          "$ref": "#/$defs/partialParams"
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/rotation"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "rotation"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/rotation"
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "position",
        "rotation",
        "scale",
        "shape",
        "color",
        "evidence",
        "visible",
        "locked"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/rotation"
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "shape": {
          "enum": [
            "ellipsoid",
            "beak"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "home": {
          "$ref": "#/$defs/home"
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "partId",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "partId": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "regionId",
        "kind",
        "count",
        "root",
        "spread",
        "rotation",
        "fan",
        "params",
        "overrides",
        "deleted",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "regionId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "feather",
            "strand"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "distribution": {
          "enum": [
            "volume",
            "ellipsoid-surface"
          ]
        },
        "root": {
          "$ref": "#/$defs/vec3"
        },
        "spread": {
          "allOf": [
            {
              "$ref": "#/$defs/vec3"
            },
            {
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              }
            }
          ]
        },
        "rotation": {
          "$ref": "#/$defs/rotation"
        },
        "fan": {
          "type": "number",
          "minimum": -6.283185307179586,
          "maximum": 6.283185307179586
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "overrides": {
          "type": "object",
          "maxProperties": 5000,
          "propertyNames": {
            "$ref": "#/$defs/slotId"
          },
          "patternProperties": {
            "^(?!(?:__proto__|prototype|constructor)/)[A-Za-z0-9_-]+/[0-9]{6}$": {
              "$ref": "#/$defs/override"
            }
          },
          "additionalProperties": false
        },
        "deleted": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slotId"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "slot"
      ],
      "properties": {
        "groupId": {
          "$ref": "#/$defs/id"
        },
        "slot": {
          "$ref": "#/$defs/slotId"
        },
        "override": {
          "$ref": "#/$defs/override"
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "partId",
        "position",
        "rotation",
        "params",
        "visible",
        "locked",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/elementId"
        },
        "kind": {
          "enum": [
            "feather",
            "strand"
          ]
        },
        "partId": {
          "$ref": "#/$defs/id"
        },
        "groupId": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/rotation"
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "original": {
          "$ref": "#/$defs/original"
        }
      }
    }
  }
}
