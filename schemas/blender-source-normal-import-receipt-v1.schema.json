{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "sourceSha256",
    "blendSha256",
    "blenderVersion",
    "fixedNormalToleranceDeg",
    "currentEditableIRAvailable",
    "sourceSpecState",
    "import"
  ],
  "properties": {
    "schema": {
      "const": "morphloom.blender-source-normal-import-receipt/0.1"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blendSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blenderVersion": {
      "type": "string"
    },
    "fixedNormalToleranceDeg": {
      "const": 0.01
    },
    "currentEditableIRAvailable": {
      "const": false
    },
    "sourceSpecState": {
      "const": "before-edit-reference"
    },
    "import": {
      "type": "object",
      "required": [
        "policy",
        "inputSha256",
        "meshCount",
        "referenceReceipts",
        "nonNormalPayloadExact",
        "hierarchyTransformsExact"
      ],
      "properties": {
        "policy": {
          "const": "morphloom.blender-source-normal-import/0.1"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "nonNormalPayloadExact": {
          "const": true
        },
        "hierarchyTransformsExact": {
          "const": true
        },
        "meshCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "referenceReceipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "mesh",
              "storage",
              "appliedMaxInputErrorDeg",
              "corners"
            ],
            "properties": {
              "mesh": {
                "type": "string"
              },
              "storage": {
                "const": "FLOAT_VECTOR/CORNER"
              },
              "appliedMaxInputErrorDeg": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.01
              },
              "corners": {
                "type": "integer",
                "minimum": 0,
                "maximum": 200000
              }
            }
          }
        }
      }
    }
  }
}
