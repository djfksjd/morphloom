{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djfksjd/morphloom/schemas/character-ir.schema.json",
  "title": "Morphloom CharacterIR 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "spec"],
  "properties": {
    "schema": { "const": "morphloom.character/0.1" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heightCm", "weight", "muscle", "ageYears", "genderBlend", "shoulderScale", "legScale", "headScale", "skinTone", "suitColor", "accentColor", "hairColor", "hairStyle", "outfit"],
      "properties": {
        "heightCm": { "type": "number", "minimum": 120, "maximum": 230 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "muscle": { "type": "number", "minimum": 0, "maximum": 1 },
        "ageYears": { "type": "number", "minimum": 18, "maximum": 90 },
        "genderBlend": { "type": "number", "minimum": 0, "maximum": 1 },
        "shoulderScale": { "type": "number", "minimum": 0.8, "maximum": 1.3 },
        "legScale": { "type": "number", "minimum": 0.8, "maximum": 1.2 },
        "headScale": { "type": "number", "minimum": 0.8, "maximum": 1.2 },
        "skinTone": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "suitColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "accentColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "hairColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "hairStyle": { "enum": ["crop", "bob", "buzz", "none"] },
        "outfit": { "enum": ["second-skin", "field", "studio"] }
      }
    }
  }
}
